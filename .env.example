# Copiá como .env y ajustá. En local casi todo por defecto.
PORT=3200
JWT_SECRET=dev-insecure-secret-cambiar-en-produccion
ACCESS_TOKEN_TTL=2h
DATABASE_FILE=./data/consultorio.db

# Admin (recepción) inicial OPCIONAL. Dejalo comentado para crearlo desde /admin.html.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
SEED_SAMPLE_DATA=true

# URL pública del sitio (para los links del email). En producción, la URL de Render.
PUBLIC_URL=http://localhost:3200

# Email de recordatorios (SMTP). Si lo dejás vacío, funciona en modo demo (loguea en consola).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Consultorio Salud+ <no-reply@saludmas.example.com>

# Cada cuánto revisa recordatorios (ms). 900000 = 15 min.
REMINDER_INTERVAL_MS=900000

TRUST_PROXY=false
NODE_ENV=development
