# Copy as .env and adjust. In local dev, most defaults are fine.
PORT=3200
JWT_SECRET=dev-insecure-secret-change-in-production
ACCESS_TOKEN_TTL=2h
DATABASE_FILE=./data/clinic.db

# Optional initial admin (front desk). Leave commented to create it from /admin.html.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
SEED_SAMPLE_DATA=true

# Public URL of the site (for the email links). In production, the Render URL.
PUBLIC_URL=http://localhost:3200

# Reminder email (SMTP). If left empty, runs in demo mode (logs to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Salud+ Clinic <no-reply@saludplus.example.com>

# How often reminders are checked (ms). 900000 = 15 min.
REMINDER_INTERVAL_MS=900000

TRUST_PROXY=false
NODE_ENV=development
